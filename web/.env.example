APP_NAME="WhatsApp Order Notifier"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8081

LOG_CHANNEL=stack
LOG_LEVEL=debug

# SQLite works out of the box. Switch to mysql/pgsql for production.
DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=whatsapp_notifier
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=sync

# Provided automatically by `shopify app dev`. Set them by hand only when running outside the CLI.
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SCOPES=read_orders,read_customers
SHOPIFY_API_VERSION=2026-04

# WhatsApp Cloud API (Meta). Per-store token and phone number id are saved from the admin panel.
WHATSAPP_GRAPH_VERSION=v21.0
WHATSAPP_DEFAULT_COUNTRY_CODE=92
